#!/bin/sh
# Faena pre-commit hook: deja el harness consistente antes de commitear.
#   1. Regenera skills/README.md si hay skills nuevas o editadas, y lo añade al commit.
#   2. Valida la integridad completa del harness.
# Activalo una vez por clon:
#   git config core.hooksPath .githooks
set -e

if command -v pwsh >/dev/null 2>&1; then
    powershell_bin="pwsh"
elif command -v powershell >/dev/null 2>&1; then
    powershell_bin="powershell"
else
    echo "faena: PowerShell no encontrado; se omite la validacion del harness."
    exit 0
fi

# 1. Catalogo de skills: reparar en vez de fallar.
"$powershell_bin" -NoProfile -ExecutionPolicy Bypass -File scripts/build-skills-index.ps1
if ! git diff --quiet -- skills/README.md; then
    git add skills/README.md
    echo "faena: skills/README.md regenerado y anadido al commit."
fi

# 2. Integridad del harness.
"$powershell_bin" -NoProfile -ExecutionPolicy Bypass -File scripts/validate-faena.ps1
