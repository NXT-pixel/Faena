{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "provider": "gemini",
  "model": "gemini-2.5-flash",
  "auto_approve": true,
  "max_turns_per_task": 15,
  "timeout_seconds": 90,
  "workspace_paths": {
    "tickets": "tasks/tickets",
    "context": "tasks/context",
    "agents": "agents",
    "rules": "rules"
  }
}
