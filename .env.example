# ==============================================================================
# FAENA AI FACTORY ENVIRONMENT CONFIGURATION
# ==============================================================================

# Default provider: claude | chatgpt | gemini | ollama | deepseek | openrouter
FAENA_PROVIDER=gemini

# Default model (optional, defaults to provider recommended model)
# FAENA_MODEL=gemini-2.5-flash

# --- Provider API Keys (Set at least one) ---

# Anthropic (Claude 3.5 Sonnet, Claude 3.7 Sonnet, Haiku)
ANTHROPIC_API_KEY=

# OpenAI (ChatGPT - GPT-4o, GPT-4o-mini, o1, o3-mini)
OPENAI_API_KEY=

# Google Gemini (Gemini 2.5 Flash, Gemini 2.5 Pro, Gemini 3.8)
GEMINI_API_KEY=

# DeepSeek (DeepSeek V3, DeepSeek R1)
DEEPSEEK_API_KEY=

# OpenRouter (Access to 200+ models via unified endpoint)
OPENROUTER_API_KEY=

# Ollama / Local Models (Optional base URL, defaults to http://localhost:11434/v1)
# OLLAMA_BASE_URL=http://localhost:11434/v1
